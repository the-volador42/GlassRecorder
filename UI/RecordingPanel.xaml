<Window x:Class="GlassRecorder.UI.RecordingPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassRecorder — запись" SizeToContent="WidthAndHeight"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Background="Transparent" FontFamily="{StaticResource UiFont}" FontSize="14">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource GlassTint}" CornerRadius="8">
    <Border x:Name="Root" Background="{StaticResource GlassSheen}" BorderBrush="{StaticResource GlassEdge}"
            BorderThickness="1" CornerRadius="8" Padding="10,8">
        <StackPanel Orientation="Horizontal">
            <!-- status + timer (drag handle) -->
            <Border x:Name="DragArea" Background="Transparent" Padding="6,0,10,0" Cursor="SizeAll" ToolTip="Перетащите, чтобы сдвинуть панель">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="14" Height="14" Margin="0,0,9,0">
                        <Ellipse x:Name="Pulse" Fill="#FF453A" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FF453A"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TimerText" Text="00:00" FontSize="17" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display Semibold, Segoe UI"/>
                        <TextBlock x:Name="StateText" Text="REC" FontSize="10" Foreground="{StaticResource SubTextBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Rectangle Width="1" Fill="{StaticResource HairlineBrush}" Margin="4,4,8,4"/>

            <Button x:Name="PauseButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="Пауза"/>
            <Button x:Name="MicButton" Style="{StaticResource IconButton}" Content="&#xE720;" ToolTip="Микрофон"/>
            <Button x:Name="ClicksButton" Style="{StaticResource IconButton}" Content="&#xE7C9;" ToolTip="Показ кликов"/>
            <Border x:Name="ZoomBadge" Width="36" Height="36" CornerRadius="18" Margin="3,0" Background="#1FFFFFFF"
                    BorderBrush="#2EFFFFFF" BorderThickness="1" ToolTip="Зум: удерживайте горячую клавишу">
                <TextBlock x:Name="ZoomGlyph" Text="&#xE71E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Rectangle Width="1" Fill="{StaticResource HairlineBrush}" Margin="8,4,6,4"/>

            <Button x:Name="StopButton" Style="{StaticResource IconButton}" ToolTip="Остановить и сохранить" Background="#FF453A">
                <Border Width="12" Height="12" CornerRadius="3" Background="White"/>
            </Button>
        </StackPanel>
    </Border>
    </Border>
</Window>
