<Window x:Class="GlassRecorder.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassRecorder" Width="900" Height="745"
        WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="14" ShowInTaskbar="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1" CaptionHeight="0" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource GlassTint}" CornerRadius="8">
    <Border Background="{StaticResource GlassSheen}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="8">
        <Grid Margin="22,14,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (drag area) -->
            <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="34" Height="34" Margin="0,0,12,0">
                        <Ellipse Stroke="#CCFFFFFF" StrokeThickness="2"/>
                        <Ellipse Width="16" Height="16" Fill="{StaticResource RecordBrush}"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GlassRecorder" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="Готов к записи · живёт в трее" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="MinButton" Style="{StaticResource IconButton}" Content="&#xE921;" FontSize="11" ToolTip="Свернуть"/>
                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="11" ToolTip="Скрыть в трей"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="РЕЖИМ ЗАПИСИ"/>
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="ModeFull" GroupName="mode" Style="{StaticResource Segment}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" Margin="0,2,8,0" FontSize="14"/>
                                            <TextBlock Text="Весь экран" FontSize="13"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ModeWindow" GroupName="mode" Style="{StaticResource Segment}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE737;" Margin="0,2,8,0" FontSize="14"/>
                                            <TextBlock Text="Активное окно" FontSize="13"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="ModeHint" FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="2,8,0,8"/>
                            <TextBlock Text="Монитор" FontSize="13" Margin="2,0,0,6"/>
                            <Border Style="{StaticResource SegmentHost}">
                                <UniformGrid x:Name="MonitorPanel" Rows="1"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="ВИДЕО"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Частота кадров" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" Width="150">
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="Fps30" GroupName="fps" Content="30 FPS" Style="{StaticResource Segment}"/>
                                        <RadioButton x:Name="Fps60" GroupName="fps" Content="60 FPS" Style="{StaticResource Segment}"/>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="Качество (битрейт)"/>
                                <TextBlock x:Name="BitrateText" HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}"/>
                            </Grid>
                            <Slider x:Name="BitrateSlider" Style="{StaticResource GlassSlider}" Minimum="4" Maximum="60" SmallChange="1" LargeChange="4" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,2,0,4"/>
                            <CheckBox x:Name="HwSwitch" Style="{StaticResource Switch}" Content="Кодирование на видеокарте"/>
                            <CheckBox x:Name="CursorSwitch" Style="{StaticResource Switch}" Content="Показывать курсор"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="ЗВУК"/>
                            <CheckBox x:Name="SysAudioSwitch" Style="{StaticResource Switch}" Content="Системный звук"/>
                            <CheckBox x:Name="MicSwitch" Style="{StaticResource Switch}" Content="Микрофон включён при старте"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="ЭФФЕКТЫ"/>
                            <CheckBox x:Name="ClicksSwitch" Style="{StaticResource Switch}">
                                <StackPanel>
                                    <TextBlock Text="Показ кликов"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Ellipse Width="9" Height="9" Fill="#FF453A" Margin="0,1,5,0"/>
                                        <TextBlock Text="ЛКМ" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,0,12,0"/>
                                        <Ellipse Width="9" Height="9" Fill="#34C759" Margin="0,1,5,0"/>
                                        <TextBlock Text="ПКМ" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </CheckBox>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="Сила зума к курсору"/>
                                <TextBlock x:Name="ZoomText" HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}"/>
                            </Grid>
                            <Slider x:Name="ZoomSlider" Style="{StaticResource GlassSlider}" Minimum="1.5" Maximum="4" SmallChange="0.25" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.25" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource CardTitle}" Text="ГОРЯЧИЕ КЛАВИШИ"/>
                                <Button x:Name="ResetKeysButton" Style="{StaticResource GlassButton}" Content="Сбросить" Padding="10,3" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            </Grid>
                            <StackPanel x:Name="HotkeyList"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Нажмите на комбинацию и зажмите новые клавиши. Esc — отмена. Клавишу Fn Windows не видит, поэтому используйте F1–F12, Ctrl, Alt, Shift и буквы."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="ПАПКА ДЛЯ ВИДЕО"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                                <Button x:Name="ChangeFolderButton" Grid.Column="1" Style="{StaticResource GlassButton}" Content="Изменить" Margin="8,0,0,0"/>
                                <Button x:Name="OpenFolderButton" Grid.Column="2" Style="{StaticResource GlassButton}" Content="Открыть" Margin="6,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="FooterHint" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                <Button x:Name="RecordButton" Style="{StaticResource RecordButton}" HorizontalAlignment="Right" MinWidth="230">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="RecordGlyph" Width="12" Height="12" CornerRadius="6" Background="White" Margin="0,1,10,0"/>
                        <TextBlock x:Name="RecordButtonText" Text="Начать запись" Foreground="White" FontWeight="SemiBold" FontSize="15"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
    </Border>
</Window>

